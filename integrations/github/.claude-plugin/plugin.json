{
  "name": "github",
  "version": "1.0.0",
  "description": "Manage repos, issues, pull requests, and Actions.",
  "author": {
    "name": "Cursor",
    "email": "plugins@cursor.com"
  },
  "homepage": "https://github.com/newwwbe/plugins/tree/main/integrations/github",
  "repository": "https://github.com/newwwbe/plugins",
  "license": "MIT",
  "keywords": [
    "github",
    "git",
    "repositories",
    "pull-requests",
    "issues",
    "actions",
    "mcp"
  ],
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${user_config.GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  },
  "userConfig": {
    "GITHUB_PERSONAL_ACCESS_TOKEN": {
      "type": "string",
      "title": "GitHub personal access token",
      "description": "Fine-grained or classic PAT from https://github.com/settings/tokens with the repo scopes you want the agent to use.",
      "required": true,
      "sensitive": true
    }
  }
}
