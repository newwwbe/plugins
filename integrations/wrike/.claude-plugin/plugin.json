{
  "name": "wrike",
  "version": "1.0.0",
  "description": "Search projects, create tasks, and post comments.",
  "author": {
    "name": "Cursor",
    "email": "plugins@cursor.com"
  },
  "homepage": "https://github.com/newwwbe/plugins/tree/main/integrations/wrike",
  "repository": "https://github.com/newwwbe/plugins",
  "license": "MIT",
  "keywords": [
    "wrike",
    "project-management",
    "tasks",
    "projects",
    "work-management",
    "mcp"
  ],
  "mcpServers": {
    "wrike": {
      "type": "http",
      "url": "https://mcp.wrike.com/v2",
      "headers": {
        "Authorization": "Bearer ${user_config.WRIKE_ACCESS_TOKEN}"
      }
    }
  },
  "userConfig": {
    "WRIKE_ACCESS_TOKEN": {
      "type": "string",
      "title": "Wrike permanent access token",
      "description": "Permanent access token created in Wrike under Apps & Integrations → API.",
      "required": true,
      "sensitive": true
    }
  }
}
