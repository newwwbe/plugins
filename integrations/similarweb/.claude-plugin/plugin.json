{
  "name": "similarweb",
  "version": "1.0.0",
  "description": "Analyze website traffic, audiences, and competitors.",
  "author": {
    "name": "Cursor",
    "email": "plugins@cursor.com"
  },
  "homepage": "https://github.com/newwwbe/plugins/tree/main/integrations/similarweb",
  "repository": "https://github.com/newwwbe/plugins",
  "license": "MIT",
  "keywords": [
    "similarweb",
    "traffic",
    "analytics",
    "competitive-intelligence",
    "audience",
    "mcp"
  ],
  "mcpServers": {
    "similarweb": {
      "type": "http",
      "url": "https://mcp.similarweb.com",
      "headers": {
        "api-key": "${user_config.SIMILARWEB_API_KEY}"
      }
    }
  },
  "userConfig": {
    "SIMILARWEB_API_KEY": {
      "type": "string",
      "title": "Similarweb API key",
      "description": "REST API key from Similarweb under Account Settings → Data Tools → REST API.",
      "required": true,
      "sensitive": true
    }
  }
}
