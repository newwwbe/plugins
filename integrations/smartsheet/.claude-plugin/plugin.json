{
  "name": "smartsheet",
  "version": "1.0.0",
  "description": "Query and update sheets, rows, and workspaces.",
  "author": {
    "name": "Cursor",
    "email": "plugins@cursor.com"
  },
  "homepage": "https://github.com/newwwbe/plugins/tree/main/integrations/smartsheet",
  "repository": "https://github.com/newwwbe/plugins",
  "license": "MIT",
  "keywords": [
    "smartsheet",
    "sheets",
    "project-management",
    "work-management",
    "rows",
    "mcp"
  ],
  "mcpServers": {
    "smartsheet": {
      "type": "http",
      "url": "https://mcp.smartsheet.com",
      "headers": {
        "Authorization": "Bearer ${user_config.SMARTSHEET_API_TOKEN}"
      }
    }
  },
  "userConfig": {
    "SMARTSHEET_API_TOKEN": {
      "type": "string",
      "title": "Smartsheet API token",
      "description": "API access token generated in Smartsheet under Account → Personal Settings → API Access.",
      "required": true,
      "sensitive": true
    }
  }
}
